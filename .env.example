# Local demo configuration. Copy to .env (which Git ignores) and change the passwords.
# Values are single-quoted so neither the shell nor Docker Compose expands the "$" in hashes.

LEDGERCORE_DB_URL='jdbc:postgresql://127.0.0.1:55432/ledgercore'
LEDGERCORE_DB_OWNER_USER='ledger_owner'
LEDGERCORE_DB_OWNER_PASSWORD='change-me-owner'
LEDGERCORE_DB_APP_USER='ledger_app'
LEDGERCORE_DB_APP_PASSWORD='change-me-app'

# Demo logins for a loopback-only demonstration (BCrypt cost 10):
#   customer-a / customer-a-demo, customer-b / customer-b-demo, demo-admin / admin-demo
LEDGERCORE_CUSTOMER_A_PASSWORD_HASH='{bcrypt}$2a$10$qCZo6rpziCAamrxq1D/w7eHdkDEbvlAWHfIV2XTMpoIgUe7h7YJCO'
LEDGERCORE_CUSTOMER_B_PASSWORD_HASH='{bcrypt}$2a$10$26iwYMkyiY5/OLG7WNkKheG0DMZv8vpCd/WCneDlDDhRVxbLL2Xrm'
LEDGERCORE_ADMIN_PASSWORD_HASH='{bcrypt}$2a$10$dlpPDSNiK/dTmBrzJB7Dc.CIP/fWxgpThPjz085UKsLOVkMzSz.X.'

# The outbox publisher's service credential: the client password and the consumer's matching hash.
LEDGERCORE_PUBLISHER_PASSWORD='publisher-demo'
LEDGERCORE_PUBLISHER_PASSWORD_HASH='{bcrypt}$2a$10$q3Xabmr/NiaUB38qrcmvueONCpdWS4t.ExxnfMjSxm5Vow3fiR1P.'
